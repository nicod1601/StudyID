{
  "name": "studyide",
  "version": "1.0.0",
  "description": "StudyIDE - Assistant de code Java/Python et organisateur de cours (Semestre 5)",
  "main": "main.js",
  "author": "Toi",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux deb AppImage",
    "dist:win": "electron-builder --win nsis portable",
    "dist:all": "electron-builder -mwl"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.studyide.app",
    "productName": "StudyIDE",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "data/**/*"
    ],
    "asarUnpack": [
      "node_modules/node-llama-cpp/**/*",
      "node_modules/@node-llama-cpp/**/*"
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Development"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "node-llama-cpp": "^3.19.1",
    "pdfjs-dist": "^3.11.174"
  }
}
